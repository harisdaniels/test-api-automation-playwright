{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "config/**/*.ts",
    "core/**/*.ts",
    "clients/**/*.ts",
    "data/**/*.ts",
    "schema/**/*.ts",
    "tests/**/*.ts"
  ]
}